{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline -20)",
{% if stack == 'python' %}
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
{% elif stack == 'node' %}
      "Bash(pnpm install*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm run typecheck*)",
{% elif stack == 'shell' %}
      "Bash(shellcheck*)",
      "Bash(shfmt*)",
      "Bash(bats*)",
{% elif stack == 'go' %}
      "Bash(go test ./...)",
      "Bash(go vet ./...)",
      "Bash(gofmt -l .)",
{% elif stack == 'rust' %}
      "Bash(cargo test --locked)",
      "Bash(cargo build --locked)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo clippy --locked --all-targets --all-features -- -D warnings)",
{% elif stack == 'c-cpp' %}
      "Bash(cmake -S . -B build)",
      "Bash(cmake --build build)",
      "Bash(ctest --test-dir build --output-on-failure)",
{% elif stack == 'latex' %}
      "Bash(latexmk -pdf -interaction=nonstopmode -halt-on-error -outdir=build main.tex)",
{% endif %}
      "Bash(pre-commit run --all-files)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(git*--ext-diff*)",
      "Bash(git -c*)",
      "Bash(git*--o*)",
      "Bash(git*--ext*)",
      "Bash(git*--no-index*)",
      "Bash(pre-commit*--config*)",
      "Bash(pre-commit*-c *)"
    ]
  }
}
