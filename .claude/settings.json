{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "Bash(pre-commit run*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(git*--ext-diff*)",
      "Bash(git -c*)"
    ]
  }
}
